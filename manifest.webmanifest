{
  "name": "图压 TinyPress · 图片压缩",
  "short_name": "图压",
  "description": "纯前端图片压缩工具：上传图片，压缩到指定大小以下，图片不会上传到任何服务器。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f7fb",
  "theme_color": "#3b82f6",
  "lang": "zh-CN",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
